# Copy to .env.local, then replace the database password with the value you
# set for lokii_app in PostgreSQL.
DATABASE_URL=postgres://lokii_app:replace-with-your-local-db-password@127.0.0.1:5432/lokii_cookies_dev?sslmode=disable
NEXT_PUBLIC_API_BASE_URL=http://localhost:8080
CORS_ALLOWED_ORIGINS=http://localhost:3000
COOKIE_SECURE=false
HTTP_ADDRESS=:8080
