# Local development only. Replace the password before using any shared environment.
POSTGRES_DB=crumbco
POSTGRES_USER=crumbco
POSTGRES_PASSWORD=change-this-local-only
DATABASE_URL=postgres://crumbco:change-this-local-only@db:5432/crumbco?sslmode=disable

# Public browser URL; this value is baked into the frontend image at build time.
API_PORT=8080
NEXT_PUBLIC_API_BASE_URL=http://localhost:8080
CORS_ALLOWED_ORIGINS=http://localhost:3000
COOKIE_SECURE=false
COOKIE_DOMAIN=
IMAGE_TAG=latest

# Optional: set both to provision the first administrator on startup.
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_PASSWORD=
