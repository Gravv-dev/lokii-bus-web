# Local development only. Replace these values before using outside your machine.
POSTGRES_DB=crumbco
POSTGRES_USER=crumbco
POSTGRES_PASSWORD=replace-this-local-development-password
DATABASE_URL=postgres://crumbco:replace-this-local-development-password@db:5432/crumbco?sslmode=disable

API_PORT=8080
NEXT_PUBLIC_API_BASE_URL=http://localhost:8080
CORS_ALLOWED_ORIGINS=http://localhost:3000
COOKIE_SECURE=false
COOKIE_DOMAIN=

# Optional: set both to provision the first administrator on startup.
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_PASSWORD=
